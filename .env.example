# ============================================================
# WEATHER AI PLATFORM — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Weather Union API (REQUIRED) -------------------------
# Get your key from: https://www.weatherunion.com/
WEATHER_UNION_API_KEY=PASTE WEATHER UNION API KEY

# ----- Database ---------------------------------------------
DATABASE_URL=postgresql://weather_user:weather_pass@localhost:5432/weather_ai_db
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_pass
POSTGRES_DB=weather_ai_db

# ----- Backend ----------------------------------------------
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENVIRONMENT=development
DEBUG=true
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Redis (caching) --------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- NWP Sources (optional — leave blank to use mock) -----
# Open-Meteo is used as a free NWP proxy for GFS/ECMWF/JMA
# No API key required for Open-Meteo free tier
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ----- ML ---------------------------------------------------
MODEL_ARTIFACT_DIR=./artifacts
TRAINING_DATA_DIR=./data/training
LOG_LEVEL=INFO
